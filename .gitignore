target/
nvim.log

# ASR model weights, when kept in the checkout; `spokenpad fetch-models`
# downloads them to $XDG_DATA_HOME/spokenpad/models.
models/

# Voice recordings: biometric data, kept local only.
eval-samples/*.wav

# Private evaluation corpus: reference transcripts of the user's own
# recordings, and other local-only evaluation data.
eval-samples/local/

# The author's development tool that uploads recordings to Gladia for
# reference transcripts (eval-samples/README.md); local only.
scripts/gladia-references.sh

# API keys for development tools (reference transcripts); never committed.
.env

# makepkg build residue (running makepkg inside packaging/aur/)
packaging/aur/src/
packaging/aur/pkg/
packaging/aur/*.tar.*
packaging/aur/*.pkg.tar.zst
