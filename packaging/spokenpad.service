[Unit]
Description=spokenpad push-to-talk dictation
Documentation=https://github.com/membranepotential/spokenpad
# Dies with the graphical session: the hotkey watcher and the dictation
# window both need X, and a daemon outliving the session it was
# started for would hold /dev/input readers open for nothing.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec

# The default asr.model_dir is relative ("models/parakeet-tdt-0.6b-v3-int8"),
# so the daemon has to run from the checkout. Set this rather than making the
# path absolute in a config file: moving the checkout then needs one edit
# here, not two in different places.
WorkingDirectory=%h/Documents/spokenpad
ExecStart=%h/Documents/spokenpad/target/release/spokenpad

# Not -v: DEBUG still goes to the rotating file at
# $XDG_STATE_HOME/spokenpad/spokenpad.log regardless, and duplicating it into
# the journal buys nothing but noise. `journalctl --user -u spokenpad` shows
# the INFO line per dictation, which is what you want when watching it live.

Restart=on-failure
RestartSec=3

# Exit 2 is "model files missing"; exit 3 is "the hotkey watcher could not
# start" -- no readable /dev/input device advertising the configured key code,
# whatever the reason (not in the input group, no such device, no /dev/input at
# all). Neither becomes true by trying again, and restarting on them turns one
# clear error into an endless loop that buries it. The code is selected by
# error type, not by matching the message, so rewording it changes nothing.
#
# Exit 1 is deliberately NOT listed: it covers "another spokenpad daemon holds
# $XDG_STATE_HOME/spokenpad/daemon.lock", which a retry three seconds later can
# legitimately resolve once the other process exits.
RestartPreventExitStatus=2 3

[Install]
WantedBy=i3-session.target
