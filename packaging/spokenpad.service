# spokenpad systemd user unit; scripts/install.sh installs it to
# ~/.config/systemd/user/spokenpad.service.
[Unit]
Description=spokenpad push-to-talk dictation
Documentation=https://github.com/membranepotential/spokenpad
# Dies with the graphical session: a daemon outliving the session it was
# started for would hold the microphone open, and its control socket, for
# nothing.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec

# scripts/install.sh copies the binary here. Models and settings come from
# the XDG directories (~/.local/share/spokenpad/models,
# ~/.config/spokenpad/config.toml), so the working directory does not matter.
ExecStart=%h/.local/bin/spokenpad

# Not -v: DEBUG still goes to the rotating file at
# $XDG_STATE_HOME/spokenpad/spokenpad.log regardless, and duplicating it into
# the journal buys nothing but noise. `journalctl --user -u spokenpad` shows
# the INFO line per dictation, which is what you want when watching it live.

Restart=on-failure
RestartSec=3

# The daemon stops itself well inside this: it gives its background threads
# three seconds, which is also the whole budget a dictation pane has to write
# what is in its buffers and close its editor. The limit is here so a stop
# that does go wrong ends in seconds rather than in systemd's default ninety,
# and it must stay comfortably above those three seconds — a SIGKILL here
# would be the thing that loses what the user typed into the pane.
TimeoutStopSec=10

# Exit 2 is "model files missing". That does not become true by trying
# again, and restarting on it turns one clear error into an endless loop that
# buries it.
#
# Exit 1 is deliberately NOT listed: it covers "another spokenpad daemon holds
# $XDG_STATE_HOME/spokenpad/daemon.lock", which a retry three seconds later can
# legitimately resolve once the other process exits.
RestartPreventExitStatus=2

[Install]
# Desktop sessions that integrate with systemd (GNOME, KDE Plasma) start
# graphical-session.target. A plain i3 or sway session does not: start this
# unit from its startup instead. Managed mode (nvim.mode = "managed") also
# needs the session's environment in the user manager, imported first:
#   exec "systemctl --user import-environment DISPLAY XAUTHORITY; systemctl --user start spokenpad"
# (on sway: SWAYSOCK WAYLAND_DISPLAY DISPLAY).
WantedBy=graphical-session.target
