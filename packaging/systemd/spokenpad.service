# spokenpad daemon. Started only through spokenpad.socket, by the first press
# of a session, so it has no [Install] section: there is nothing to enable.
[Unit]
Description=spokenpad push-to-talk dictation
Documentation=https://github.com/membranepotential/spokenpad
Requires=spokenpad.socket
After=spokenpad.socket
# Stops with the graphical session where the desktop has one (GNOME, KDE
# Plasma): a daemon outliving the session it was started for would hold the
# microphone open, and the display it draws on, for nothing. The socket stays,
# and the next session's first press starts a fresh daemon.
PartOf=graphical-session.target

[Service]
Type=exec
# Models and settings come from the XDG directories
# (~/.local/share/spokenpad/models, ~/.config/spokenpad/config.toml), so the
# working directory does not matter. For development, point this at a build
# of your own with the drop-in in packaging/systemd/dev.conf.example.
ExecStart=/usr/bin/spokenpad

# Not -v: DEBUG still goes to the rotating file at
# $XDG_STATE_HOME/spokenpad/spokenpad.log regardless, and duplicating it into
# the journal buys nothing but noise. `journalctl --user -u spokenpad` shows
# the INFO line per dictation, which is what you want when watching it live.

# Nothing a user can get wrong ends the daemon once it has taken its socket:
# a missing model, a microphone that is not there yet, or a config file that
# does not load (it runs on the defaults) are each said in the dictation
# window and retried. Its one deliberate exit is 3, "another spokenpad daemon
# holds $XDG_STATE_HOME/spokenpad/daemon.lock" -- one started by hand. It
# answers the waiting presses before it exits, so that they do not start it
# again, and it is not restarted: the press after the other daemon stops
# starts this one. A crash is restarted.
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=3

# The daemon stops itself well inside this: it gives its background threads
# three seconds, which is also the whole budget a dictation pane has to write
# what is in its buffers and close its editor. The limit is here so a stop
# that does go wrong ends in seconds rather than in systemd's default ninety,
# and it must stay comfortably above those three seconds: a SIGKILL here
# would be the thing that loses what the user typed into the pane.
TimeoutStopSec=10
